{
  "rules": {
    "users": {
      ".read": "auth != null && root.child('users').child(auth.uid).child('admin').val() === true",
      "$uid": {
        ".read": "auth != null && auth.uid === $uid",
        ".write": "auth != null && (root.child('users').child(auth.uid).child('admin').val() === true || (auth.uid === $uid && newData.exists() && newData.child('memberUntil').val() === data.child('memberUntil').val()))",
        "admin": {
          ".validate": "root.child('users').child(auth.uid).child('admin').val() === true || newData.val() === data.val() || newData.val() === false"
        },
        "member": {
          ".validate": "root.child('users').child(auth.uid).child('admin').val() === true || newData.val() === data.val() || newData.val() === false"
        },
        "memberSince": {
          ".validate": "root.child('users').child(auth.uid).child('admin').val() === true || newData.val() === data.val()"
        },
        "memberUntil": {
          ".validate": "root.child('users').child(auth.uid).child('admin').val() === true || newData.val() === data.val()"
        },
        "isFullMarathonVerified": {
          ".validate": "root.child('users').child(auth.uid).child('admin').val() === true || newData.val() === data.val() || newData.val() === false"
        },
        "isHalfMarathonVerified": {
          ".validate": "root.child('users').child(auth.uid).child('admin').val() === true || newData.val() === data.val() || newData.val() === false"
        },
        "strava_activities": {
          ".read": "auth != null && (auth.uid === $uid || root.child('users').child(auth.uid).child('member').val() === true)"
        }
      }
    },
    "user_profiles": {
      ".read": "auth != null",
      "$uid": {
        ".write": "auth != null && (root.child('users').child(auth.uid).child('admin').val() === true || (auth.uid === $uid && newData.exists() && newData.child('memberUntil').val() === data.child('memberUntil').val()))",
        "admin": {
          ".validate": "root.child('users').child(auth.uid).child('admin').val() === true || newData.val() === newData.parent().parent().parent().child('users').child($uid).child('admin').val()"
        },
        "member": {
          ".validate": "root.child('users').child(auth.uid).child('admin').val() === true || newData.val() === newData.parent().parent().parent().child('users').child($uid).child('member').val()"
        },
        "memberSince": {
          ".validate": "root.child('users').child(auth.uid).child('admin').val() === true || newData.val() === newData.parent().parent().parent().child('users').child($uid).child('memberSince').val()"
        },
        "memberUntil": {
          ".validate": "root.child('users').child(auth.uid).child('admin').val() === true || newData.val() === newData.parent().parent().parent().child('users').child($uid).child('memberUntil').val()"
        },
        "isFullMarathonVerified": {
          ".validate": "root.child('users').child(auth.uid).child('admin').val() === true || newData.val() === newData.parent().parent().parent().child('users').child($uid).child('isFullMarathonVerified').val()"
        },
        "isHalfMarathonVerified": {
          ".validate": "root.child('users').child(auth.uid).child('admin').val() === true || newData.val() === newData.parent().parent().parent().child('users').child($uid).child('isHalfMarathonVerified').val()"
        }
      }
    },
    "challenges": {
      ".read": "auth != null",
      "$challengeId": {
        ".write": "auth != null && root.child('users').child(auth.uid).child('admin').val() === true",
        "user_challenges": {
          "$uid": {
            ".write": "auth != null && auth.uid === $uid"
          }
        }
      }
    },
    "notifications": {
      ".read": "auth != null",
      "$notificationId": {
        ".write": "auth != null && root.child('users').child(auth.uid).child('admin').val() === true",
        "readBy": {
          "$uid": {
            ".write": "auth != null && auth.uid === $uid"
          }
        },
        "likes": {
          "$uid": {
            ".write": "auth != null && auth.uid === $uid"
          }
        }
      }
    },
    "deleted_users": {
      ".read": "auth != null"
    },
    "settings": {
      ".read": "auth != null",
      ".write": "auth != null && root.child('users').child(auth.uid).child('admin').val() === true"
    },
    "finance": {
      ".read": "auth != null && (root.child('users').child(auth.uid).child('admin').val() === true || root.child('users').child(auth.uid).child('member').val() === true)",
      ".write": "auth != null && root.child('users').child(auth.uid).child('admin').val() === true"
    },
    "gifts": {
      ".read": "auth != null",
      ".write": "auth != null && root.child('users').child(auth.uid).child('admin').val() === true"
    },
    "lucky_draws": {
      ".read": "auth != null",
      "$drawId": {
        ".write": "auth != null && root.child('users').child(auth.uid).child('admin').val() === true",
        "participants": {
          "$key": {
            ".write": "auth != null && $key === auth.uid && root.child('lucky_draws').child($drawId).child('status').val() === 'open' && (!newData.exists() || (newData.child('uid').val() === auth.uid && newData.child('source').val() === 'self' && newData.child('name').isString() && newData.child('name').val().length > 0 && newData.child('name').val().length <= 100))"
          }
        }
      }
    },
    "EVENT": {
      ".read": "auth != null",
      ".write": "auth != null && root.child('users').child(auth.uid).child('admin').val() === true"
    }
  }
}
